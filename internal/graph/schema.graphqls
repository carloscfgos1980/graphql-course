type Category {
  id: ID!
  name: String!
  description: String
  createdAt: String!
  updatedAt: String!
  courses: [Course!]!
}

type Course {
  id: ID!
  name: String!
  description: String
  createdAt: String!
  updatedAt: String!
  category: Category!
}

input NewCategory {
  name: String!
  description: String
}

input NewCourse {
  name: String!
  description: String
  categoryId: ID!
}

type Query {
  categories: [Category!]!
  category(id: ID!): Category
  courses: [Course!]!
}

type Mutation {
  createCategory(input: NewCategory!): Category!
  updateCategory(id: ID!, name: String, description: String): Category!
  deleteCategory(id: ID!): Boolean!
  createCourse(input: NewCourse!): Course!
}